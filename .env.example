# ── Core (required) ─────────────────────────────────────────────────────────
# Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service-role key — server only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── AI (optional at build time; app guards at runtime) ─────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...

# ── Payments (optional at build time; app guards at runtime) ────────────────
# https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=...
# Razorpay → Settings → Webhooks (event: payment.captured)
RAZORPAY_WEBHOOK_SECRET=...
RAZORPAY_PLAN_PRO_INDIVIDUAL_MONTHLY=placeholder
RAZORPAY_PLAN_PRO_INDIVIDUAL_ANNUAL=placeholder
RAZORPAY_PLAN_FAMILY_MONTHLY=placeholder
RAZORPAY_PLAN_FAMILY_ANNUAL=placeholder

# ── Email invites (optional; falls back to shareable invite code) ───────────
# https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=CareDesk <onboarding@resend.dev>

# ── Misc (optional) ─────────────────────────────────────────────────────────
# Public URL used in invite emails when request origin is unavailable
APP_URL=http://localhost:3000
